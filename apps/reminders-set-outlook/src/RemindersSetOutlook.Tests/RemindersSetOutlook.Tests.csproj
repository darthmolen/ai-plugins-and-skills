<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>RemindersSetOutlook.Tests</RootNamespace>
    <!-- Test names are the documentation; constant arrays in assertions are not a hot path. -->
    <NoWarn>$(NoWarn);SA1600;CS1591;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RemindersSetOutlook/RemindersSetOutlook.csproj" />
  </ItemGroup>

</Project>
