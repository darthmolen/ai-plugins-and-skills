{
  "Scan": {
    "Roots": [],
    "Include": [ "**/planning/reminders/**/*.md" ],
    "Exclude": [ "**/.git/**", "**/node_modules/**", "**/bin/**", "**/obj/**" ],
    "RequireReminderKind": true
  },
  "Todo": {
    "ListName": "Reminders",
    "ReminderField": "remind",
    "DueField": "due",
    "DefaultReminderTime": "09:00",
    "TimeZone": "",
    "ApplyCategories": true
  },
  "Auth": {
    "ClientId": "",
    "TenantId": "common",
    "Mode": "Browser",
    "AllowInteractive": true,
    "AllowUnencryptedTokenCache": false
  },
  "State": {
    "Directory": "",
    "CsvFileName": "reminders.csv"
  },
  "Watch": {
    "IntervalMinutes": 15
  }
}
