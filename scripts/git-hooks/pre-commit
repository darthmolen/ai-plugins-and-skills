#!/usr/bin/env bash
# Regenerate index.json / README.md / ARCHITECTURE.md when SKILL.md files change.
# Runs only if a SKILL.md (or this hook's siblings) is staged; aborts the commit
# if validation fails, otherwise re-stages the regenerated artifacts.

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# ── Sanitization gate ─────────────────────────────────────────────────
# This repository was created by lifting skills out of a corporate repo. That
# de-CSAT pass was a one-time manual grep: case-sensitive, and with a pattern
# that never covered the resource prefixes actually in use. Production
# hostnames, a client name and a bootstrap script name shipped anyway, and sat
# here for weeks (see .lift-audit/AUDIT.md). This is the same idea made
# automatic, case-insensitive, and run against *staged content* rather than a
# working tree somebody remembered to check.
#
# It runs before the early exit below on purpose: a leak can arrive in a .cs
# script or a doc, not only in a SKILL.md.
#
# SKIP_SANITIZE_CHECK=1 bypasses it, for edits to .lift-audit/ itself, which
# necessarily quotes the strings being banned.

SANITIZE_PATTERN='csatsolutions|\bcsat\b|csat[-_.]|\bdell\b|\bddr\b|\bipqc\b|ai_server_bolt|14 day loopers|\bdomino\b|\blenovo\b|\blethal\b|\bcheetah\b|\bcubiscan\b|e22c1771|sql-delta|sbns-delta|pg-delta|\bdelta\b|stage-engineering'

if [ -z "${SKIP_SANITIZE_CHECK:-}" ]; then
    sanitize_hits=""
    while IFS= read -r staged_file; do
        case "$staged_file" in
            .lift-audit/*) continue ;;
        esac
        hit=$(git show ":$staged_file" 2>/dev/null | grep -nIiE "$SANITIZE_PATTERN" || true)
        if [ -n "$hit" ]; then
            sanitize_hits="${sanitize_hits}
--- ${staged_file} ---
${hit}"
        fi
    done < <(git diff --cached --name-only --diff-filter=ACM)

    if [ -n "$sanitize_hits" ]; then
        echo "pre-commit: corporate identifiers in staged content - commit aborted." >&2
        echo "$sanitize_hits" >&2
        echo "" >&2
        echo "  This is a public BSD-2-Clause repository. Replace the identifier with a" >&2
        echo "  placeholder (your-server, your-db, example-messages, ...) and stage again." >&2
        echo "  Bypass, for .lift-audit/ edits only:  SKIP_SANITIZE_CHECK=1 git commit ..." >&2
        exit 1
    fi
fi

# Matches the main collection at skills/ and any opt-in plugin at plugins/<name>/skills/.
if ! git diff --cached --name-only | grep -qE '^((plugins/[^/]+/)?skills/.*SKILL\.md|scripts/build_index\.py)$'; then
    exit 0
fi

# Find an interpreter that can actually run build_index.py. `python3` alone is not
# enough: on Windows it is often the Microsoft Store alias, and the interpreter that
# answers to a given name is not always the one carrying PyYAML. The test is therefore
# "can it import yaml", not "does the name resolve".
find_python() {
    local candidates=(python3 python "py -3" py)
    local cmd
    for cmd in "${candidates[@]}"; do
        command -v "${cmd%% *}" >/dev/null 2>&1 || continue
        if $cmd -c 'import yaml' >/dev/null 2>&1; then
            echo "$cmd"
            return 0
        fi
    done
    return 1
}

if [ -n "${PYTHON:-}" ]; then
    # An explicit choice is honoured strictly — no silent fallback, so CI fails loudly
    # rather than building with an interpreter nobody asked for.
    if ! $PYTHON -c 'import yaml' >/dev/null 2>&1; then
        echo "pre-commit: PYTHON=\"$PYTHON\" cannot import yaml - commit aborted." >&2
        echo "  Install it there:  $PYTHON -m pip install pyyaml" >&2
        exit 1
    fi
    PY="$PYTHON"
elif ! PY=$(find_python); then
    echo "pre-commit: no Python with PyYAML found - commit aborted." >&2
    echo "  Tried: python3, python, py -3, py. build_index.py needs PyYAML to read" >&2
    echo "  SKILL.md frontmatter." >&2
    echo "  Install it:        python -m pip install pyyaml" >&2
    echo "  Or name one:       PYTHON=\"py -3.12\" git commit ..." >&2
    exit 1
fi

if ! $PY scripts/build_index.py; then
    echo "build_index.py failed - commit aborted." >&2
    exit 1
fi

git add index.json README.md documentation/ARCHITECTURE.md
